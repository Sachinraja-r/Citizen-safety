# Supabase Backend Configuration (Person 2)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI Triage Engine Configuration (Person 3)
# Person 3's FastAPI server endpoint: POST /api/v1/ai-location/triage
# Locally: uvicorn backend.app.api.routes:app --host 0.0.0.0 --port 8000 --reload
# The Vite dev server proxies /api/v1/ai-location/* -> http://localhost:8000
# so VITE_AI_ENGINE_URL should be left EMPTY during local dev (proxy handles it).
# For production, set this to the deployed AI engine URL (e.g. https://ai.raksha.app)
VITE_AI_ENGINE_URL=

# Development and Demo Fallback
# When true or when Supabase keys are empty, the app operates in zero-config Demo Mode
VITE_ENABLE_DEV_DEMO=true

# Google Firebase Authentication (for "Continue with Google")
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Automated Cellular SMS & WhatsApp Dispatch Gateway (Serverless / Twilio / Meta Cloud)
# When configured on Vercel or locally, the backend automatically sends real cellular SMS
# and real WhatsApp messages to every emergency contact without manual user interaction.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Alternative SMS Gateway (e.g. Fast2SMS for direct India carrier SMS)
FAST2SMS_API_KEY=

# Custom Emergency Dispatch Webhook (optional URL to receive alert payloads)
DISPATCH_WEBHOOK_URL=
